  "/api/consultant/powerlink": {
   "post": {
    "tags": [
     "Consultor"
    ],
    "summary": "Retorna o PowerLink do consultor por email ou telefone",
    "description": "Consulta PowerLink do consultor a partir de e-mail ou telefone. Os valores são normalizados e validados antes da busca.",
    "operationId": "getConsultantPowerLinkUsingPOST",
    "requestBody": {
     "description": "Informe e-mail ou telefone (ao menos um dos campos).",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ConsultantPowerLinkRequest"
       },
       "examples": {
        "searchByEmail": {
         "summary": "Busca pelo e-mail do consultor",
         "value": {
          "email": "consultor@empresa.com.br"
         }
        },
        "searchByPhone": {
         "summary": "Busca pelo telefone do consultor",
         "value": {
          "phone": "(31) 99999-8888"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Consulta realizada com sucesso.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ConsultantPowerLinkResponse"
        },
        "examples": {
         "success": {
          "summary": "Consultor encontrado",
          "value": {
           "powerlinkId": "abc123",
           "name": "Fulano da Silva",
           "email": "consultor@empresa.com.br",
           "phone": "(31) 99999-8888",
           "powerlinks": [
            {
             "name": "Powerlink principal",
             "link": "https://app.powercrm.com.br/powerlink?id=abc123"
            }
           ],
           "powerlinkAffiliate": "https://app.powercrm.com.br/affiliateFormPage/abc123"
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "Informe email ou telefone usando os campos \"email\" ou \"phone\" para realizar a busca.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "message": {
           "type": "string"
          }
         }
        },
        "examples": {
         "missingContact": {
          "value": {
           "message": "Informe email ou telefone usando os campos \"email\" ou \"phone\" para realizar a busca."
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Consultor não encontrado.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "message": {
           "type": "string"
          }
         }
        },
        "examples": {
         "notFound": {
          "value": {
           "message": "Consultor não encontrado."
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "Erro interno ao buscar o consultor.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "message": {
           "type": "string"
          }
         }
        },
        "examples": {
         "internalError": {
          "value": {
           "message": "Não foi possível buscar o consultor no momento. Tente novamente mais tarde."
          }
         }
        }
       }
      }
     },
     "503": {
      "description": "Serviço indisponível.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "message": {
           "type": "string"
          }
         }
        },
        "examples": {
         "serviceUnavailable": {
          "value": {
           "message": "Serviço indisponível."
          }
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "apiKey": [
       "global"
      ]
     }
    ]
   }
  },
  "/api/quotation/card/move": {
   "post": {
    "tags": [
     "Cotação"
    ],
    "summary": "Move o card de uma negociação para uma etapa específica do pipeline",
    "operationId": "moveCardQuotationUsingPOST",
    "parameters": [
     {
      "name": "quotationCode",
      "in": "query",
      "description": "Código da cotação",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "cardColumn",
      "in": "query",
      "description": "Coluna de destino do pipeline",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "RECEIVED",
        "IN_NEGOTIATION",
        "INSPECTION",
        "RELEASED_FOR_REGISTRATION",
        "COMPLETED"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Cotação movida para a coluna especificada.",
      "content": {
       "application/json": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "400": {
      "description": "Coluna inválida",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorVO"
        }
       }
